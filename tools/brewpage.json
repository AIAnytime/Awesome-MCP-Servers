  {
   "name": "publish",
   "title": "Publish on BrewPage",
   "description": "Shared public namespace: public:true (or namespace:\"public\"); ordinary link-only: omit both. HTML: content; kind=site: files; kind=file: url; kind=json: json; kind=kv: key,value. Site: {\"kind\":\"site\",\"public\":true,\"files\":[{\"path\":\"index.html\",\"content\":\"<h1>Hi</h1>\"}]}. A public input URL does not request listing. New HTML titles go in <title>; preserve supplied HTML. For visitor input read get_guide topic page-data first; publish HTML and state together. Use domain for an owned hostname.",
   "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
     "__schema0": {
      "type": [
       "object",
       "array",
       "string",
       "number",
       "boolean",
       "null"
      ]
     },
     "__schema1": {
      "type": [
       "string",
       "number",
       "boolean",
       "null",
       "array",
       "object"
      ]
     }
    },
    "properties": {
     "kind": {
      "description": "Default html",
      "type": "string",
      "enum": [
       "html",
       "site",
       "file",
       "json",
       "kv"
      ]
     },
     "content": {
      "description": "HTML, Markdown or code.",
      "type": "string"
     },
     "format": {
      "description": "HTML only. html, markdown or a code language",
      "type": "string"
     },
     "verbatim": {
      "description": "Preserve inline source by default. False allows paste repair.",
      "type": "boolean"
     },
     "filename": {
      "description": "Original filename.",
      "type": "string"
     },
     "files": {
      "description": "Full site bundle.",
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "path": {
         "type": "string"
        },
        "content": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "content"
       ]
      }
     },
     "entry": {
      "description": "Site entry path, default index.html",
      "type": "string"
     },
     "url": {
      "description": "Public HTTP(S) URL fetched directly by the tool. No local download needed.",
      "type": "string"
     },
     "json": {
      "description": "Pass objects/arrays directly: {\"x\":1}. Strings are stored as strings.",
      "$ref": "#/$defs/__schema0"
     },
     "key": {
      "description": "KV key. Excludes hosting.",
      "type": "string"
     },
     "value": {
      "description": "String value for kind=kv",
      "type": "string"
     },
     "tags": {
      "description": "Tags. Updates accept tags only on HTML and sites",
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "state": {
      "description": "Page data configuration for HTML-format pages and sites. {} enables, null disables on update",
      "anyOf": [
       {
        "type": "object",
        "additionalProperties": {
         "$ref": "#/$defs/__schema1"
        }
       },
       {
        "type": "null"
       }
      ]
     },
     "title": {
      "description": "HTML create only, at most 200 Unicode code points. Checks the existing static document head title before publishing, not stored metadata or script changes. Omit when no check is needed.",
      "type": "string"
     },
     "public": {
      "description": "True selects the shared public namespace. Conflicting namespace refuses. Omit for existing defaults; false disallows namespace=public.",
      "type": "boolean"
     },
     "namespace": {
      "description": "Use public for the shared public namespace, or a custom namespace. Omit for existing defaults.",
      "type": "string"
     },
     "password": {
      "description": "New reader password. Omit for no password. Send only the exact password requested, never a placeholder.",
      "type": "string"
     },
     "ttlDays": {
      "anyOf": [
       {
        "type": "number",
        "exclusiveMinimum": 0
       },
       {
        "type": "string"
       }
      ]
     },
     "ownerToken": {
      "description": "Private owner proof.",
      "type": "string"
     },
     "requireAccount": {
      "description": "Require account ownership.",
      "type": "boolean"
     },
     "deliveryMode": {
      "type": "string",
      "enum": [
       "path",
       "subdomain"
      ]
     },
     "domain": {
      "description": "Hostname on HTML-format pages or sites, with the required owning profile",
      "type": "string"
     },
     "template": {
      "description": "Template slug for an HTML copy",
      "type": "string"
     }
    }
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "openWorldHint": true
   }
  },
