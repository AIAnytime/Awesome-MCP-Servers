  {
   "name": "publication_settings",
   "title": "Change publication settings",
   "description": "Change listing, badge, title, password, storage, hosting or Page data on an owned publication. Use a disruptive action alone. Ask before making a publication private: its public address stops working.",
   "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "namespace": {
      "description": "Namespace from the publication receipt",
      "type": "string"
     },
     "id": {
      "description": "ID from the publication receipt",
      "type": "string"
     },
     "ownerToken": {
      "description": "Private owner proof.",
      "type": "string"
     },
     "manageUrl": {
      "description": "Private link as target and proof.",
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "html",
       "site",
       "file",
       "json",
       "kv"
      ]
     },
     "action": {
      "description": "Use alone. Making private is one-way, replaces the public address and detaches its custom domain",
      "type": "string",
      "enum": [
       "make_private",
       "rotate_link",
       "reset_manage_link",
       "revoke_reader_access"
      ]
     },
     "listed": {
      "description": "List or unlist an eligible public publication",
      "type": "boolean"
     },
     "badgeHidden": {
      "description": "Hide or show the BrewPage badge",
      "type": "boolean"
     },
     "title": {
      "description": "One-line title; empty restores the content title",
      "type": "string"
     },
     "password": {
      "description": "Reader password; null removes it",
      "type": [
       "string",
       "null"
      ]
     },
     "extend": {
