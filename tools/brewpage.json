       "subdomain"
      ]
     },
     "expectedVersion": {
      "description": "Hosting version, with deliveryMode only",
      "type": "integer",
      "minimum": 1
     },
     "state": {
      "description": "{} enables Page data, named rules merge, null disables and keeps entries",
      "anyOf": [
       {
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     }
    }
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "openWorldHint": true
