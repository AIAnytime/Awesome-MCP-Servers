{
 "server": "FindAIforWork",
 "checked": "2026-11-14",
 "tools": [
  {
   "name": "compare_tools",
   "title": "Compare AI tools",
   "description": "Compare two to five published tools side by side. Unknown slugs are reported in missing instead of being guessed.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "slugs": {
      "minItems": 2,
      "maxItems": 5,
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      },
      "description": "Two to five listing slugs"
     }
    },
    "required": [
     "slugs"
    ]
   },
   "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "get_tool",
   "title": "Get one AI tool",
   "description": "Return the full public listing for one tool by slug, including its Markdown copy and related tools.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Listing slug, for example \"chatgpt\""
     }
    },
    "required": [
     "slug"
    ]
   },
   "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "list_categories",
   "title": "List categories",
   "description": "List every active category with its slug, description and the number of published tools in it.",
   "inputSchema": {
    "type": "object",
    "properties": {}
   },
   "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "search_tools",
   "title": "Search AI tools",
   "description": "Search published AI software listings by free text, category slug or pricing model. Returns a total plus compact summaries.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "query": {
      "description": "Free text matched against name, tagline, description",
      "type": "string",
      "maxLength": 200
     },
     "category": {
      "description": "Category slug from list_categories",
      "type": "string",
      "maxLength": 80
     },
     "pricing": {
      "description": "Pricing model filter",
      "type": "string",
      "enum": [
       "FREE",
       "FREEMIUM",
       "PAID",
       "OPEN_SOURCE",
       "CONTACT_SALES"
      ]
     },
     "sort": {
      "description": "Result order; defaults to latest",
      "type": "string",
      "enum": [
       "latest",
       "trending",
       "az"
      ]
     },
     "limit": {
      "description": "Maximum results, 1-25; defaults to 10",
      "type": "integer",
      "minimum": 1,
      "maximum": 25
     }
    }
   },
   "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
   }
  }
 ]
}
