     },
     "namespace": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "manageUrl": {
      "description": "Private link as target and proof.",
      "type": "string"
     },
     "ownerToken": {
      "description": "Private owner proof.",
      "type": "string"
     },
     "key": {
      "description": "KV key. Excludes hosting.",
      "type": "string"
     }
    }
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "openWorldHint": true
   }
  },
  {
   "name": "domains",
   "title": "Manage custom domains",
   "description": "List, add, attach, check, detach or remove custom domains. Attach requires a hostname and an HTML page or site target. Set the returned DNS records at the provider, then check once and read status with get. Detach keeps the hostname registered.",
   "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "list",
       "get",
       "add",
       "attach",
       "check",
       "detach",
       "remove"
      ]
     },
     "kind": {
      "type": "string",
      "enum": [
       "html",
       "site"
      ]
     },
     "namespace": {
