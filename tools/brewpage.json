{
 "server": "BrewPage",
 "checked": "2026-11-21",
 "tools": [
  {
   "name": "account",
   "title": "Check or manage a BrewPage connection",
   "description": "Check connection status, view masked tokens or change account publishing access. Use status with requireAccount=true to request a connection.",
   "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "status",
       "tokens",
       "bind_token",
       "mint_token",
       "rename_token",
       "revoke_token",
       "revoke_others",
       "claim",
       "unclaim"
      ]
     },
     "requireAccount": {
      "type": "boolean"
     },
     "ownerToken": {
      "description": "Private profile proof.",
      "type": "string"
     },
     "token": {
      "description": "Owner token to add using existing admin proof",
      "type": "string"
     },
     "tokenId": {
      "type": "string",
      "format": "uuid"
     },
     "keep": {
      "maxItems": 100,
      "type": "array",
      "items": {
       "type": "string",
       "format": "uuid"
      }
     },
     "label": {
      "type": "string"
     },
     "scope": {
      "type": "string",
      "enum": [
       "publish",
       "admin"
      ]
     },
     "expiresIn": {
      "type": "string",
      "enum": [
       "30d",
       "90d",
       "1y",
       "never"
      ]
     },
     "manageUrl": {
      "description": "Private link as target and proof.",
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "html",
       "site",
       "file",
       "json",
       "kv"
      ]
     },
     "namespace": {
      "type": "string"
     },
     "id": {
      "type": "string"
     }
    }
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "delete_page_data",
   "title": "Delete page data entries",
   "description": "Permanently delete entries or uploaded files from one list. Select docIds, fileIds, a timestamp range or all=true.",
   "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "namespace": {
      "description": "Namespace from the publication receipt",
      "type": "string"
     },
     "id": {
      "description": "ID from the publication receipt",
      "type": "string"
     },
     "ownerToken": {
      "description": "Private owner proof.",
      "type": "string"
     },
     "manageUrl": {
      "description": "Private link as target and proof.",
      "type": "string"
     },
     "kind": {
      "type": "string",
      "enum": [
       "html",
       "site"
      ]
     },
     "collection": {
      "type": "string",
      "description": "List name"
     },
     "docIds": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
       "type": "string",
       "description": "ID from read_page_data"
      }
     },
     "fileIds": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
       "type": "string",
       "description": "ID from read_page_data"
      }
     },
     "after": {
      "description": "Exclusive lower timestamp bound",
      "type": "string"
     },
     "before": {
      "description": "Exclusive upper timestamp bound",
      "type": "string"
     },
     "all": {
      "description": "Explicit true deletes all entries and files",
      "type": "boolean"
     }
    },
    "required": [
     "collection"
    ]
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "openWorldHint": true
   }
  },
  {
   "name": "delete_publication",
   "title": "Delete a BrewPage publication or KV key",
   "description": "Permanently delete the exact publication. For KV, specify key to delete that key only. Deleting the last key also removes the store. Omitting key deletes the entire store.",
   "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "kind": {
      "description": "Publication kind returned by publish or list",
