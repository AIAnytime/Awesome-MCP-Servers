ctiveHint":false,"idempotentHint":true,"openWorldHint":false}},{"name":"search_episode_evidence","title":"Find episode question evidence","description":"Retrieve reviewed paraphrased evidence for a question about one episode. Defaults to that episode as the spoiler ceiling. Matching is lexical; no matching evidence is not proof that an event did not happen. Never invent an answer or quote dialogue.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"slug":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"season":{"default":1,"anyOf":[{"type":"integer","minimum":0,"maximum":20000},{"type":"string","pattern":"^(?:0|[1-9][0-9]{0,6})$"}]},"number":{"anyOf":[{"type":"integer","minimum":0,"maximum":20000},{"type":"string","pattern":"^(?:0|[1-9][0-9]{0,6})$"}]},"question":{"type":"string","minLength":3,"maxLength":1000},"maxResults":{"default":6,"anyOf":[{"type":"integer","minimum":1,"maximum":10},{"type":"string","pattern":"^(?:0|[1-9][0-9]{0,6})$"}]},"spoilerPolicy":{"default":"through_episode","type":"string","enum":["none","through_episode","all"]},"throughSeason":{"anyOf":[{"type":"integer","minimum":0,"maximum":20000},{"type":"string","pattern":"^(?:0|[1-9][0-9]{0,6})$"}]},"throughEpisode":{"anyOf":[{"type":"integer","minimum":0,"maximum":20000},{"type":"string","pattern":"^(?:0|[1-9][0-9]{0,6})$"}]}},"required":["slug","number","question"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"idempotentHint":true,"openWorldHint":false}}],"resources":[]}