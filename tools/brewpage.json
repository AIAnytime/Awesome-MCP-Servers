      "type": "string"
     },
     "id": {
      "description": "ID from the publication receipt",
      "type": "string"
     },
     "hostname": {
      "description": "Bare hostname, e.g. schedule.example.org. Required to add, attach or detach",
      "type": "string"
     },
     "ownerToken": {
      "description": "Private owner proof.",
      "type": "string"
     }
    }
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "openWorldHint": true
   }
